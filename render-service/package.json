{
  "name": "@openmaic/render-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated Node 22 + Chromium + FFmpeg service that renders exported Hyperframes projects to MP4 (OpenMAIC issue #866).",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "lint": "eslint --max-warnings=0 src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hyperframes/producer": "^0.7.107",
    "@openmaic/dsl": "0.11.0",
    "@openmaic/renderer": "0.1.4",
    "echarts": "^6.0.0",
    "esbuild": "0.28.1",
    "fflate": "^0.8.2",
    "hono": "^4.6.14",
    "motion": "^12.27.5",
    "parse5": "^8.0.1",
    "puppeteer-core": "^25.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shiki": "^3.21.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/node": "^22.10.2",
    "eslint": "10.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.67.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
